# Porta em que a aplicação vai rodar
PORT=3000

# Ambiente (development | production)
NODE_ENV=development

# Dados de conexão com o banco MySQL (Aiven, Neon ou similar)
DB_HOST=seu-host-aiven.aivencloud.com
DB_PORT=puerto_fornecido_pelo_aiven
DB_USER=avnadmin
DB_PASSWORD=sua_senha_do_banco
DB_NAME=eventhub
DB_SSL=true

# Segredo usado para assinar o cookie de sessão (gere uma string aleatória grande)
SESSION_SECRET=troque_isso_por_uma_string_bem_grande_e_aleatoria
